{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && node --test supabase/tests/contact.test.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "prepare": "husky",
    "images": "node scripts/optimize-images.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{json,css,md,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/josefin-sans": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
